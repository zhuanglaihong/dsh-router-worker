{
  "name": "dsh-subagent-tree",
  "version": "0.2.0",
  "type": "module",
  "description": "一个插件两件事：把子代理对话画成主对话的缩进子树（连接线、短名、状态、折叠），并自带「Router 项目经理模式」——主对话只拆任务派工单，读写执行全下放子代理。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/shots"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-agent-preset",
    "sidebar",
    "subagent",
    "tree",
    "session-tree",
    "router-worker",
    "orchestration"
  ],
  "license": "MIT",
  "author": "lighthope",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lighthope/dsh-subagent-tree.git"
  },
  "bugs": {
    "url": "https://github.com/lighthope/dsh-subagent-tree/issues"
  },
  "homepage": "https://github.com/lighthope/dsh-subagent-tree#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
